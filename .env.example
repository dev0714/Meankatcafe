SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cat-images

# --- Social Studio (AI post generation + publishing) ---
# Claude (caption generation)
ANTHROPIC_API_KEY=
