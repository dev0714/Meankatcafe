# Encrypts social OAuth tokens at rest (any long random string)
SOCIAL_TOKEN_SECRET=
# Base URL of this app, used for OAuth redirect callbacks (Phase 2+)
APP_BASE_URL=http://localhost:3000

# Platform OAuth apps (Phase 2+ — fill in as each app review is approved)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
